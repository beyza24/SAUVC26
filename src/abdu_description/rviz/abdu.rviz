Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 40
      Color: 30; 90; 120
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Marker Scale: 0.4
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Class: rviz_default_plugins/LaserScan
      Color: 80; 220; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Sonar
      Size (Pixels): 4
      Size (m): 0.08
      Style: Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /abdu/sonar
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: FrontCamera
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /abdu/front_camera/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Tespit
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /abdu/debug/view
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odom
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /abdu/odom
      Keep: 120
  Enabled: true
  Global Options:
    Background Color: 8; 28; 40
    Fixed Frame: odom
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: -4
      Name: Current View
      Pitch: 0.45
      Yaw: 1.2
Window Geometry:
  FrontCamera:
    collapsed: false
  Height: 960
  Width: 1600
  X: 40
  Y: 40
