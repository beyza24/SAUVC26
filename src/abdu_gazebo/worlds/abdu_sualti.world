<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="abdu_sualti">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>40</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <scene>
      <ambient>0.12 0.28 0.36 1</ambient>
      <background>0.02 0.14 0.22 1</background>
      <fog>
        <color>0.06 0.28 0.38 1</color>
        <type>linear</type>
        <start>10</start>
        <end>55</end>
        <density>0.04</density>
      </fog>
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>40.85</latitude_deg>
      <longitude_deg>29.12</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <!-- Zayıf, mavi-yeşil su altı ışığı -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.55 0.78 0.88 1</diffuse>
      <specular>0.22 0.35 0.42 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.7</constant>
        <linear>0.012</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>-0.15 0.08 -1.0</direction>
    </light>

    <light name="fill_spawn" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>1 -3 -3.2 0 0 0</pose>
      <diffuse>0.45 0.70 0.82 1</diffuse>
      <specular>0.12 0.20 0.25 1</specular>
      <attenuation>
        <range>22</range>
        <constant>0.25</constant>
        <linear>0.05</linear>
        <quadratic>0.008</quadratic>
      </attenuation>
    </light>

    <light name="caustic_1" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>4 -3 -2 0 0 0</pose>
      <diffuse>0.18 0.45 0.55 1</diffuse>
      <specular>0.05 0.12 0.16 1</specular>
      <attenuation>
        <range>18</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="caustic_2" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-6 8 -7 0 0 0</pose>
      <diffuse>0.12 0.35 0.48 1</diffuse>
      <specular>0.04 0.10 0.14 1</specular>
      <attenuation>
        <range>16</range>
        <constant>0.5</constant>
        <linear>0.09</linear>
        <quadratic>0.012</quadratic>
      </attenuation>
    </light>

    <light name="wreck_lamp" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>12 -6 -9 0 0 0</pose>
      <diffuse>0.55 0.42 0.22 1</diffuse>
      <specular>0.15 0.10 0.05 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.3</constant>
        <linear>0.12</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
    </light>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.2 -2.8 -0.40 0 0.30 0.50</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

