    <!-- Kapı sonrası: 80 cm kırmızı/sarı/mavi fişek + golf topu (dinamik, çarpınca devrilir) -->
    <!-- Havuz tabanı z=-1.60; fişek 0.80 m; top r=0.028 m pole tepesinde -->
    <model name="knock_red">
      <static>false</static>
      <pose>4.90 0.70 -1.20 0 0 0</pose>
      <self_collide>false</self_collide>
      <allow_auto_disable>false</allow_auto_disable>
      <link name="pole">
        <inertial>
          <pose>0 0 0.16 0 0 0</pose>
          <mass>0.42</mass>
          <inertia>
            <ixx>0.026</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.026</iyy><iyz>0</iyz>
            <izz>0.0005</izz>
          </inertia>
        </inertial>
        <collision name="shaft">
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.80</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.28</mu>
                <mu2>0.28</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>120000</kp>
                <kd>40</kd>
                <max_vel>1.2</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <collision name="base">
          <pose>0 0 -0.390 0 0 0</pose>
          <geometry>
            <box>
              <size>0.11 0.11 0.022</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.32</mu>
                <mu2>0.32</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="shaft">
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.80</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://__ABDU_WATER_SCRIPTS__</uri>
              <name>Abdu/KnockRed</name>
            </script>
          </material>
        </visual>
        <visual name="base">
          <pose>0 0 -0.390 0 0 0</pose>
          <geometry>
            <box>
              <size>0.11 0.11 0.022</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://__ABDU_WATER_SCRIPTS__</uri>
              <name>Abdu/KnockRed</name>
            </script>
          </material>
        </visual>
      </link>
      <link name="ball">
        <pose>0 0 0.428 0 0 0</pose>
        <inertial>
          <mass>0.045</mass>
          <inertia>
            <ixx>1.4e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.4e-5</iyy><iyz>0</iyz>
            <izz>1.4e-5</izz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry>
            <sphere>
              <radius>0.028</radius>
            </sphere>
          </geometry>
          <surface>
            <bounce>
              <restitution_coefficient>0.25</restitution_coefficient>
              <threshold>0.08</threshold>
            </bounce>
            <friction>
              <ode>
                <mu>0.35</mu>
                <mu2>0.35</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry>
            <sphere>
              <radius>0.028</radius>
            </sphere>
          </geometry>
          <material>
            <script>
              <uri>file://__ABDU_WATER_SCRIPTS__</uri>
              <name>Abdu/GolfBall</name>
            </script>
          </material>
        </visual>
      </link>
      <joint name="ball_sit" type="revolute">
        <parent>pole</parent>
        <child>ball</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-3.14</lower>
            <upper>3.14</upper>
            <effort>0.0</effort>
            <velocity>8</velocity>
          </limit>
          <dynamics>
            <damping>0.002</damping>
            <friction>0.004</friction>
          </dynamics>
        </axis>
        <physics>
          <ode>
            <cfm>0.01</cfm>
            <erp>0.2</erp>
          </ode>
        </physics>
      </joint>
    </model>

