        <!-- Sol dikme: alttan beyaz, kırmızı/siyah, üstte 10 cm kırmızı -->
        <visual name="l_white">
          <pose>0 0.77 0.05 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.10</size></box></geometry>
          <material>
